pipeline {
  agent {
    docker {
      image 'abhishekf5/maven-abhishek-docker-agent:v1'
      args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
    }
  }

  environment {
    DOCKER_IMAGE = "nihitkumar/spring-boot-app:${BUILD_NUMBER}"
    MANIFEST_REPO = "spring-boot-app-manifests"
    MANIFEST_USER = "nihitkumar"
    SONAR_URL = "http://13.200.205.163:9000/"
  }

  stages {

    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Build and Test') {
      steps {
        sh 'mvn clean package'
      }
    }

    stage('Static Code Analysis') {
      steps {
        withCredentials([string(credentialsId: 'sonarqube', variable: 'SONAR_AUTH_TOKEN')]) {
          sh """
            mvn sonar:sonar \
              -Dsonar.login=$SONAR_AUTH_TOKEN \
              -Dsonar.host.url=${SONAR_URL}
          """
        }
      }
    }

    stage('Build and Push Docker Image') {
      steps {
        script {
          sh "docker build -t ${DOCKER_IMAGE} ."

          docker.withRegistry('https://index.docker.io/v1/', 'docker-cred') {
            def img = docker.image("${DOCKER_IMAGE}")
            img.push()
          }
        }
      }
    }

    stage('Update Deployment File') {
      steps {
        withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
          sh '''
            git config user.email "nihitkumar39@gmail.com"
            git config user.name "Nihit Kumar"

            # clone manifests repo
            git clone https://${GITHUB_TOKEN}@github.com/${MANIFEST_USER}/${MANIFEST_REPO}.git
            cd spring-boot-app-manifests

            # update image tag
            sed -i "s|replaceImageTag|${BUILD_NUMBER}|g" deployment.yml

            git add deployment.yml
            git commit -m "Update image tag to ${BUILD_NUMBER}" || echo "No changes to commit"
            git push origin main
          '''
        }
      }
    }

  }
}
